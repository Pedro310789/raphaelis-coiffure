---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { CTALink } from "@/types/modules";
import { buttonVariants } from "@/components/primitives/button.astro";
import Container from "@/components/primitives/container.astro";
import Heading from "@/components/primitives/heading.astro";
import { cn } from "@/lib/utils";

const collectionImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/collections/*",
  { eager: true },
);

interface CollectionImage {
  src: string;
  alt: string;
  title: string;
  description: string;
}

export interface Props {
  overline: string;
  heading: string;
  body: string[];
  images: CollectionImage[];
  cta: CTALink;
}

const { overline, heading, body, images, cta } = Astro.props;
---

<section class="bg-muted">
  <Container size="page" as="div" class="py-10 md:py-20 xl:py-24">
    <div class="flex flex-col items-center gap-12 xl:gap-24">
      {/* Heading block */}
      <div class="flex w-full flex-col items-center gap-6 text-center">
        <div class="flex flex-col items-center gap-4">
          <p
            class="text-[10px]/[1.3] md:text-xs/[1.3] font-normal uppercase tracking-wider text-muted-foreground"
          >
            {overline}
          </p>
          <div class="h-px w-12 bg-muted-foreground" aria-hidden="true"></div>
        </div>
        <Heading
          as="h2"
          size="h2"
          balance={false}
          animation="fade-up"
          class="text-center text-[36px]/none md:text-[46px]/none xl:text-[56px]/none"
        >
          {heading}
        </Heading>
        <div
          class="reveal-on-scroll animate-fade-up flex w-full max-w-[856px] flex-col gap-4 text-center text-base/[1.5] text-body-foreground"
          style="--reveal-delay: 120ms"
        >
          {body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      {/* Image grid + CTA */}
      <div class="flex w-full flex-col items-center gap-10 xl:gap-14">
        <div
          class="animate-stagger grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
        >
          {
            /*
             * Two curated images (Figma node 3336-6709) sit centered in what
             * used to be a 4-up row: placing them in the middle two columns
             * at `lg` keeps their size identical to the old quarter-width
             * layout, with the outer two columns left empty as equal
             * left/right margins.
             */
            images.map((item, index) => {
              const imgKey = `/${item.src}`;
              const imgData = collectionImages[imgKey]?.default;
              return (
                <figure
                  class={cn(
                    "reveal-on-scroll animate-fade-up flex flex-col gap-4",
                    index === 0 ? "lg:col-start-2" : "lg:col-start-3",
                  )}
                >
                  <div class="group relative aspect-3/4 w-full overflow-hidden">
                    {imgData ? (
                      <Image
                        src={imgData}
                        alt={item.alt}
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                        widths={[300, 600, 816]}
                        sizes="(min-width: 1024px) 25vw, 50vw"
                        loading="lazy"
                      />
                    ) : (
                      <img
                        src={item.src}
                        alt={item.alt}
                        class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                        loading="lazy"
                      />
                    )}
                  </div>
                  <figcaption class="flex flex-col gap-1 text-muted-foreground">
                    <p class="text-[10px]/[1.3] md:text-xs/[1.3] font-normal uppercase tracking-wider">
                      {item.title}
                    </p>
                    <p class="text-sm/[1.5] tracking-[0.01em]">
                      {item.description}
                    </p>
                  </figcaption>
                </figure>
              );
            })
          }
        </div>

        <a
          href={cta.href}
          class={cn(
            buttonVariants({ variant: "main" }),
            "reveal-on-scroll animate-fade-up",
          )}
        >
          {cta.label}
        </a>
      </div>
    </div>
  </Container>
</section>
